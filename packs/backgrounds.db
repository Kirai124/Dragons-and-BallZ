{"_id":"6f71a08e879ccd04","name":"High Class Warrior","type":"background","img":"systems/dragons-and-ballz/icons/svg/items/background.svg","system":{"description":{"value":"<p>&lt;br&gt;</p>\n<p><em>Choose this Background if your Character High Class Warrior of a Civilisation</em></p>\n<ul>\n<li>Gain Proficiency in the Perception and Intimidation Skill.</li>\n<li>Gain proficiency in 2 <strong>Tool Kits</strong> of your choice.</li>\n<li>Gain 1 <strong>Heroic Feature</strong> or 1 <strong>Feat</strong> that you fit the requirements for.</li>\n<li>Gain one rank 2 <em><strong>Techniques</strong></em> or two rank 1 <em><strong>Technique</strong></em> that you fit the requirements for.</li>\n</ul>\n","chat":""},"identifier":"high-class-warrior","source":{"custom":"Dragons and BallZ Handbook"},"advancement":{"e99b9f1635760463":{"_id":"e99b9f1635760463","type":"Trait","configuration":{"allowReplacements":false,"choices":[],"grants":["skills:itm","skills:prc"],"mode":"default"},"value":{},"level":0,"title":"Background Skills","hint":"Perception and Intimidation"},"a68e560f95c78bff":{"_id":"a68e560f95c78bff","type":"Trait","configuration":{"allowReplacements":false,"choices":[{"count":2,"pool":["tool:*"]}],"grants":[],"mode":"default"},"value":{},"level":0,"title":"Tool Proficiencies","hint":"Choose two tool proficiencies."},"2e9e42d1c9d544ab":{"_id":"2e9e42d1c9d544ab","type":"ItemChoice","configuration":{"allowDrops":false,"choices":{"0":{"count":1,"replacement":false}},"pool":[{"uuid":"Compendium.dragons-and-ballz.features-training.Item.83d1da74999852bc","sort":0},{"uuid":"Compendium.dragons-and-ballz.features-training.Item.bf2495022c075029","sort":1},{"uuid":"Compendium.dragons-and-ballz.features-training.Item.cacc4697e7f1685e","sort":2},{"uuid":"Compendium.dragons-and-ballz.features-training.Item.b9839826ac28259b","sort":3},{"uuid":"Compendium.dragons-and-ballz.features-training.Item.9369581db4f2e2b8","sort":4},{"uuid":"Compendium.dragons-and-ballz.features-training.Item