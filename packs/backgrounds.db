{"_id":"d8a62257f2d47b8d","name":"God of Destruction","type":"background","img":"systems/dragons-and-ballz/icons/svg/items/background.svg","system":{"description":{"value":"<p>&lt;br&gt;</p>\n<p><em>Choose this Background if your Character is or was the God of Destruction of a Universe</em></p>\n<ul>\n<li>Gain Proficiency in the History and Perception Skill.</li>\n<li>Gain proficiency in 2 <strong>Tool Kits</strong> of your choice.</li>\n<li>Gain 1 <strong>Heroic Feature</strong> or 1 <strong>Feat</strong> that you fit the requirements for.</li>\n<li>Gain one rank 2 <em><strong>Techniques</strong></em> or two rank 1 <em><strong>Technique</strong></em> that you fit the requirements for.</li>\n</ul>\n","chat":""},"identifier":"god-of-destruction","source":{"custom":"Dragons and BallZ Handbook"},"advancement":{"29186554536257db":{"_id":"29186554536257db","type":"Trait","configuration":{"allowReplacements":false,"choices":[],"grants":["skills:his","skills:prc"],"mode":"default"},"value":{},"level":0,"title":"Background Skills","hint":"History and Perception"},"1450b4c480f15308":{"_id":"1450b4c480f15308","type":"Trait","configuration":{"allowReplacements":false,"choices":[{"count":2,"pool":["tool:*"]}],"grants":[],"mode":"default"},"value":{},"level":0,"title":"Tool Proficiencies","hint":"Choose two tool proficiencies."},"857a53f622a675a6":{"_id":"857a53f622a675a6","type":"ItemChoice","configuration":{"allowDrops":false,"choices":{"0":{"count":1,"replacement":false}},"pool":[{"uuid":"Compendium.dragons-and-ballz.features-training.Item.83d1da74999852bc","sort":0},{"uuid":"Compendium.dragons-and-ballz.features-training.Item.bf2495022c075029","sort":1},{"uuid":"Compendium.dragons-and-ballz.features-training.Item.cacc4697e7f1685e","sort":2},{"uuid":"Compendium.dragons-and-ballz.features-training.Item.b9839826ac28259b","sort":3},{"uuid":"Compendium.dragons-and-ballz.features-training.Item.9369581db4f2e2b8","sort":4},{"uuid":"Compendium.dragons-and-ballz.features-training.Item