s-training.Item.3e786ee112fcea9f","sort":47},{"uuid":"Compendium.dragons-and-ballz.features-training.Item.6b1bbc8cd9968688","sort":48},{"uuid":"Compendium.dragons-and-ballz.features-training.Item.1e2803fc714c672b","sort":49},{"uuid":"Compendium.dragons-and-ballz.features-training.Item.8de1457e71f3207e","sort":50},{"uuid":"Compendium.dragons-and-ballz.features-training.Item.5bab286def296792","sort":51},{"uuid":"Compendium.dragons-and-ballz.features-training.Item.3b64dceeec9504f8","sort":52},{"uuid":"Compendium.dragons-and-ballz.features-training.Item.5dd3b3a911bf76f5","sort":53},{"uuid":"Compendium.dragons-and-ballz.features-training.Item.16a5fe4ac492f2ec","sort":54},{"uuid":"Compendium.dragons-and-ballz.features-training.Item.0b6fec048a838621","sort":55},{"uuid":"Compendium.dragons-and-ballz.features-training.Item.ed40f5e1c2671516","sort":56},{"uuid":"Compendium.dragons-and-ballz.features-training.Item.4f919899e05a62a3","sort":57},{"uuid":"Compendium.dragons-and-ballz.features-training.Item.deeee023b9523f09","sort":58},{"uuid":"Compendium.dragons-and-ballz.features-training.Item.f0f0461d9c5fb41c","sort":59},{"uuid":"Compendium.dragons-and-ballz.features-training.Item.daa8cb8e976df160","sort":60},{"uuid":"Compendium.dragons-and-ballz.features-training.Item.9484b8bf0fcb2ad2","sort":61},{"uuid":"Compendium.dragons-and-ballz.features-training.Item.f35c1c4876bf5a16","sort":62}],"restriction":{"level":"","list":[],"subtype":"","type":""},"sorting":"a","spell":null,"type":"feat"},"value":{"added":{},"replaced":{}},"title":"Heroic Features","hint":"Choose Heroic Features from the handbook."},"7ce4bfaa0f13457e":{"_id":"7ce4bfaa0f13457e","type":"ItemGrant","configuration":{"items":[{"uuid":"Compendium.dragons-and-ballz.features-training.Item.e2008dfd04f59322","optional":false,"sort":0}],"optional":false,"sorting":"m","spell":null},"value":{},"level":18,"title":"Class Features — Level 18","hint":""},"bcccf7c80f2fae59":{"_id":"bcccf7c80f2fae59","type":"ItemGrant","configuration