-and-ballz.features-training.Item.60b0fc6d17ac7eb5","sort":32},{"uuid":"Compendium.dragons-and-ballz.features-training.Item.e1b362588553a445","sort":33},{"uuid":"Compendium.dragons-and-ballz.features-training.Item.e10625d96093adf0","sort":34},{"uuid":"Compendium.dragons-and-ballz.features-training.Item.84a5e9d34e35b736","sort":35},{"uuid":"Compendium.dragons-and-ballz.features-training.Item.8b63b2e54916cf86","sort":36},{"uuid":"Compendium.dragons-and-ballz.features-training.Item.b50419d2e8688d1e","sort":37},{"uuid":"Compendium.dragons-and-ballz.features-training.Item.acccefec9a0fd18b","sort":38},{"uuid":"Compendium.dragons-and-ballz.features-training.Item.ac0ab5f161e3110e","sort":39},{"uuid":"Compendium.dragons-and-ballz.features-training.Item.f4c23ce153d06073","sort":40},{"uuid":"Compendium.dragons-and-ballz.features-training.Item.e42fdc9381ae56ac","sort":41},{"uuid":"Compendium.dragons-and-ballz.features-training.Item.740cc8d5c878b3ca","sort":42},{"uuid":"Compendium.dragons-and-ballz.features-training.Item.52b01461c90b0e62","sort":43},{"uuid":"Compendium.dragons-and-ballz.features-training.Item.4a433e83b1b32069","sort":44},{"uuid":"Compendium.dragons-and-ballz.features-training.Item.b97b5f1b6f4627da","sort":45},{"uuid":"Compendium.dragons-and-ballz.features-training.Item.ce16a4fe9a16ddd1","sort":46},{"uuid":"Compendium.dragons-and-ballz.features-training.Item.3e786ee112fcea9f","sort":47},{"uuid":"Compendium.dragons-and-ballz.features-training.Item.6b1bbc8cd9968688","sort":48},{"uuid":"Compendium.dragons-and-ballz.features-training.Item.1e2803fc714c672b","sort":49},{"uuid":"Compendium.dragons-and-ballz.features-training.Item.8de1457e71f3207e","sort":50},{"uuid":"Compendium.dragons-and-ballz.features-training.Item.5bab286def296792","sort":51},{"uuid":"Compendium.dragons-and-ballz.features-training.Item.3b64dceeec9504f8","sort":52},{"uuid":"Compendium.dragons-and-ballz.features-training.Item.5dd3b3a911bf76f5","sort":53},{"uuid":"Compendium.dragons-and-ballz.features-