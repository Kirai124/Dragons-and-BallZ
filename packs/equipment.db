{"_id":"5bb65852957fbb86","name":"Armor Class (AC)","type":"loot","img":"systems/dragons-and-ballz/icons/svg/items/loot.svg","system":{"description":{"value":"<p>Armor protects its wearer from attacks. The armor (and shield) you wear determines your base Armor Class.</p>\n","chat":""},"identifier":"armor-class-ac","source":{"custom":"Dragons and BallZ Handbook"},"quantity":1,"weight":{"value":0,"units":"lb"},"price":{"value":0,"denomination":"zeni"},"rarity":"","type":{"value":"","subtype":""}},"effects":[],"folder":null,"flags":{"dragons-and-ballz":{"handbook":{"chapter":"Dragons and BallZ Handbook","startLine":9246,"endLine":9248},"contentCategory":"equipment"}}}
