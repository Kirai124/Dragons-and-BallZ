{"_id":"6366a20548154769","name":"Shields","type":"loot","img":"systems/dragons-and-ballz/icons/svg/items/loot.svg","system":{"description":{"value":"<p>A shield is made from wood or metal and is carried in one hand. Wielding a shield increases your Armor Class by 2. You can benefit from only one shield at a time.</p>\n","chat":""},"identifier":"shields","source":{"custom":"Dragons and BallZ Handbook"},"quantity":1,"weight":{"value":0,"units":"lb"},"price":{"value":0,"denomination":"zeni"},"rarity":"","type":{"value":"","subtype":""}},"effects":[],"folder":null,"flags":{"dragons-and-ballz":{"handbook":{"chapter":"Dragons and BallZ Handbook","startLine":9255,"endLine":9257},"contentCategory":"equipment"}}}
