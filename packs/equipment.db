{"_id":"39411b6bb7d9afc4","name":"Tier 3 Scouter","type":"equipment","img":"systems/dragons-and-ballz/icons/svg/items/equipment.svg","system":{"description":{"value":"<p>Using this headgear like device you may search for ki without the feature as an action.</p>\n<p>If you scan someone with more than a +7 Power bonus or 15 levels in a class with Ki this device explodes.</p>\n","chat":""},"identifier":"tier-3-scouter","source":{"custom":"Dragons and BallZ Handbook"},"quantity":1,"weight":{"value":0,"units":"lb"},"price":{"value":0,"denomination":"zeni"},"rarity":"","type":{"value":"","subtype":""}},"effects":[],"folder":null,"flags":{"dragons-and-ballz":{"handbook":{"chapter":"Dragons and BallZ Handbook","startLine":9911,"endLine":9917},"contentCategory":"equipment"}}}
