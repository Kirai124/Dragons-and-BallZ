{"_id":"603ca8bb61f291b2","name":"Hetap™ (Stamina Potion)","type":"consumable","img":"systems/dragons-and-ballz/icons/svg/items/consumable.svg","system":{"description":{"value":"<p>&quot;With Hercule Satan himself as the sponser you know nothing in this world quenches you like <em>Hetap</em>. This refressing energy drink is guaranteed to make you feel ready to fight 2 more tournaments or your money back.</p>\n<p><em>Hetap is not responsible for injury or failed tournaments in the pursuit of this goal.</em>&quot;\nEach time you drink a Hetap™ after the first per long rest you gain ranks of <em>Exhaustion</em> as listed in the table.</p>\n<table>\n<thead>\n<tr>\n  <th style=\"text-align:left\">Size</th>\n  <th style=\"text-align:center\">Cost</th>\n  <th style=\"text-align:center\">Stamina Regained</th>\n  <th style=\"text-align:center\">Exhaustion</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n  <td style=\"text-align:left\">Lesser</td>\n  <td style=\"text-align:center\">Ƶ150,000</td>\n  <td style=\"text-align:center\">1d4+1</td>\n  <td style=\"text-align:center\">1</td>\n</tr>\n<tr>\n  <td style=\"text-align:left\">Hetap™</td>\n  <td style=\"text-align:center\">Ƶ1,500,000</td>\n  <td style=\"text-align:center\">1d6+2</td>\n  <td style=\"text-align:center\">2</td>\n</tr>\n<tr>\n  <td style=\"text-align:left\">Greater</td>\n  <td style=\"text-align:center\">Ƶ6,000,000</td>\n  <td style=\"text-align:center\">1d8+3</td>\n  <td style=\"text-align:center\">3</td>\n</tr>\n<tr>\n  <td style=\"text-align:left\">Superior</td>\n  <td style=\"text-align:center\">Ƶ60,000,000</td>\n  <td style=\"text-align:center\">1d10+4</td>\n  <td style=\"text-align:center\">4</td>\n</tr>\n<tr>\n  <td style=\"text-align:left\">Supreme</td>\n  <td style=\"text-align:center\">Ƶ600,000,000</td>\n  <td style=\"text-align:center\">1d12+5</td>\n  <td style=\"text-align:center\">5</td>\n</tr>\n</tbody>\n</table>\n","chat":""},"identifier":"hetaptm-stamina-potion","source":{"custom":"Dragons and BallZ Handbook"},"quantity":1,"weight":{"value":0,"units":"lb"},"price":{"value":0,"denomination":"zeni"},"rarity":"","type":{"value":"","subtype":""}},"effects":[],"folder":null,"flags":{"dragons-and-ballz":{"handbook":{"chapter":"Dragons and BallZ Handbook","startLine":9581,"endLine":9599},"contentCategory":"equipment"}}}
