{"_id":"a9a4b6040dfb6f6f","name":"Light Battle Armor","type":"equipment","img":"systems/dragons-and-ballz/icons/svg/items/equipment.svg","system":{"description":{"value":"<p><strong>Armor Class:</strong> 12 + Dexterity Modifier + Half Proficiency Bonus</p>\n<p><strong>Stealth:</strong> -</p>\n<p>See Chapter 10: Equipment for the full armor rules.</p>\n","chat":""},"identifier":"light-battle-armor","source":{"custom":"Dragons and BallZ Handbook"},"quantity":1,"weight":{"value":0,"units":"lb"},"price":{"value":450000,"denomination":"zeni"},"rarity":"","type":{"value":"light","subtype":""},"armor":{"value":12,"magicalBonus":"","dex":99},"proficient":null,"properties":[],"strength":0},"effects":[],"folder":null,"flags":{"dragons-and-ballz":{"handbook":{"chapter":"Dragons and BallZ Handbook","startLine":9235,"endLine":9385},"contentCategory":"equipment"}}}
{"_id":"aa5b09230138dd4d","name":"Crowbar","type":"loot","img":"systems/dragons-and-ballz/icons/svg/items/loot.svg","system":{"description":{"value":"<p><strong>Cost:</strong> Ƶ20,000 | <strong>Weight:</strong> 6 lb</p>\n","chat":""},"identifier":"crowbar","source":{"custom":"Dragons and BallZ Handbook"},"quantity":1,"weight":{"value":6,"units":"lb"},"price":{"value":20000,"denomination":"zeni"},"rarity":"","type":{"value":"","subtype":""}},"effects":[],"folder":null,"flags":{"dragons-and-ballz":{"handbook":{"chapter":"Dragons and BallZ Handbook","startLine":9723,"endLine":9775},"contentCategory":"equipment"}}}
{"_id":"ac00329c027ed6a7","name":"Potara earrings","type":"equipment","img":"systems/dragons-and-ballz/icons/svg/items/equipment.svg","system":{"description":{"value":"<p>Earrings of the Kais that allow fusion. The users must wear them in opposite ears, they are then merged into one entity. When two creatures would put on this matching set of earrings, they count as being under the Metamorean Fusion Dance Feature as if they both succeeded the Performance Check.\nYou may put the earring on or switch the ear it is being worn in as a bonus action on your turn.</p>\n<ul>\n<li>If neither fusee is a <em>Kai</em> you defuse after using 60 stamina</li>\n<li>If one fusee is a <em>Kai</em> you defuse after using 75 stamina.</li>\n<li>If both fusees are <em>Kais</em> you defuse after using 90 stamina.</li>\n<li>If either fusee is a <em>Supreme Kai</em> then the effect is permanent and no longer drains <strong>Stamina</strong> unless undone by way of the dragon balls or similar wishing abilities.</li>\n</ul>\n<p>Once the fusion ends one hour must pass before the Earrings can be used again.</p>\n","chat":""},"identifier":"potara-earrings","source":{"custom":"Dragons and BallZ Handbook"},"quantity":1,"weight":{"value":0,"units":"lb"},"price":{"value":0,"denomination":"zeni"},"rarity":"","type":{"value":"","subtype":""}},"effects":[],"folder":null,"flags":{"dragons-and-ballz":{"handbook":{"chapter":"Dragons and BallZ Handbook","startLine":9953,"endLine":9966},"contentCategory":"equipment"}}}
{"_id":"ad0be970eb6383e7","name":"Fruit of the Tree of Might","type":"equipment","img":"systems/dragons-and-ballz/icons/svg/items/equipment.svg","system":{"description":{"value":"<p><em>Wondrous Item, Legendary</em>\nA fruit created by the <em>Tree of Might</em>, also known as the Fruit of the Kais. However growing the tree drains planets out of their energy until nothing is left. You may as a bonus action eat the fruit, each time giving you 2 <strong>Training Boons</strong>. You may benefit from eating multiple fruits.</p>\n<p>If you are at <strong>Ki Rank 3</strong>, you may eat the Fruit of the Tree of Might, giving you access to the <em>Dark Energy</em> <strong>Power-Up</strong>.</p>\n","chat":""},"identifier":"fruit-of-the-tree-of-might","source":{"custom":"Dragons and BallZ Handbook"},"quantity":1,"weight":{"value":0,"units":"lb"},"price":{"value":0,"denomination":"zeni"},"rarity":"","type":{"value":"","subtype":""}},"effects":[],"folder":null,"flags":{"dragons-and-ballz":{"handbook":{"chapter":"Dragons and BallZ Handbook","startLine":9943,"endLine":9952},"contentCategory":"equipment"}}}
