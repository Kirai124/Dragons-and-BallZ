<form class="{{cssClass}} flexcol dbz-character-sheet" autocomplete="off">

  <header class="sheet-header">
    <div class="left">
      <div class="identity">
        <img class="profile-img" src="{{actor.img}}" data-edit="img" title="{{actor.name}}" width="110" height="110">
        <div class="identity-fields">
          <input class="document-name" name="name" type="text" value="{{actor.name}}" placeholder="Character Name">
          <div class="subtitle-row">
            <div class="header-field">
              <span>{{localize "DBZ.Race"}}</span>
              <strong>{{#if system.details.race}}{{system.details.race}}{{else}}—{{/if}}</strong>
            </div>
            <div class="header-field">
              <span>{{localize "DBZ.Level"}}</span>
              <input type="number" name="system.attributes.level" value="{{system.attributes.level}}" data-dtype="Number">
            </div>
            <div class="header-field">
              <span>{{localize "DBZ.Alignment"}}</span>
              <select name="system.details.alignment">
                <option value="">—</option>
                {{selectOptions alignments selected=system.details.alignment localize=true}}
              </select>
            </div>
            <div class="header-field">
              <span>{{localize "DBZ.Background"}}</span>
              <input type="text" name="system.details.background" value="{{system.details.background}}" placeholder="—">
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="right">
      <div class="level-badge">
        <span class="label">{{localize "DBZ.Level"}}</span>
        <span class="value">{{system.attributes.level}}</span>
      </div>
      <div class="header-metric">
        <span>{{localize "DBZ.PowerLevel"}}</span>
        <strong>{{numberFormat system.attributes.powerlevel}}</strong>
      </div>
      <div class="header-metric">
        <span>{{localize "DBZ.Proficiency"}}</span>
        <strong>{{numberFormat system.attributes.prof sign=true}}</strong>
      </div>
    </div>
  </header>

  <div class="sheet-body">
    <aside class="sidebar">

      <section class="filigree-box resources">
        <h3><i class="fas fa-bolt"></i><span>{{localize "DBZ.Resources"}}</span></h3>

        <div class="meter hp">
          <div class="meter-label">{{localize "DBZ.HP"}}</div>
          <div class="meter-values">
            <input type="number" name="system.attributes.hp.value" value="{{system.attributes.hp.value}}" data-dtype="Number">
            <span>/</span>
            <input type="number" name="system.attributes.hp.max" value="{{system.attributes.hp.max}}" data-dtype="Number">
          </div>
          <input class="temp" type="number" name="system.attributes.hp.temp" value="{{system.attributes.hp.temp}}" data-dtype="Number" placeholder="{{localize 'DBZ.Temp'}}">
        </div>

        <div class="meter stamina">
          <div class="meter-label">{{localize "DBZ.Stamina"}}</div>
          <div class="meter-values">
            <input type="number" name="system.attributes.stamina.value" value="{{system.attributes.stamina.value}}" data-dtype="Number">
            <span>/</span>
            <input type="number" name="system.attributes.stamina.max" value="{{system.attributes.stamina.max}}" data-dtype="Number">
          </div>
          <input class="temp" type="number" name="system.attributes.stamina.temp" value="{{system.attributes.stamina.temp}}" data-dtype="Number" placeholder="{{localize 'DBZ.Temp'}}">
        </div>

        <div class="meter ki">
          <div class="meter-label">{{localize "DBZ.Ki"}}</div>
          <div class="meter-values">
            <input type="number" name="system.attributes.ki.value" value="{{system.attributes.ki.value}}" data-dtype="Number">
            <span>/</span>
            <input type="number" name="system.attributes.ki.max" value="{{system.attributes.ki.max}}" data-dtype="Number">
          </div>
          <input class="temp" type="number" name="system.attributes.ki.temp" value="{{system.attributes.ki.temp}}" data-dtype="Number" placeholder="{{localize 'DBZ.Temp'}}">
        </div>

        <div class="meter godki">
          <div class="meter-label">{{localize "DBZ.GodKi"}}</div>
          <div class="meter-values">
            <input type="number" name="system.attributes.godki.value" value="{{system.attributes.godki.value}}" data-dtype="Number">
            <span>/</span>
            <input type="number" name="system.attributes.godki.max" value="{{system.attributes.godki.max}}" data-dtype="Number">
          </div>
        </div>
      </section>

      <section class="filigree-box combat-stats">
        <h3><i class="fas fa-shield-halved"></i><span>{{localize "DBZ.Combat"}}</span></h3>
        <div class="lozenge-row">
          <div class="lozenge"><strong>{{system.attributes.ac.value}}</strong><span>{{localize "DBZ.AC"}}</span></div>
          <div class="lozenge"><strong>{{system.attributes.movement.walk}}</strong><span>{{localize "DBZ.Speed"}}</span></div>
          <div class="lozenge"><strong>{{system.attributes.kirank}}</strong><span>{{localize "DBZ.KiRank"}}</span></div>
          <div class="lozenge"><strong>{{numberFormat system.attributes.power.value sign=true}}</strong><span>{{localize "DBZ.Power"}}</span></div>
        </div>
        <div class="combat-inputs">
          <label>{{localize "DBZ.AC"}} <input type="number" name="system.attributes.ac.value" value="{{system.attributes.ac.value}}" data-dtype="Number"></label>
          <label>{{localize "DBZ.Speed"}} <input type="number" name="system.attributes.movement.walk" value="{{system.attributes.movement.walk}}" data-dtype="Number"></label>
          <label>{{localize "DBZ.Power"}} <input type="number" name="system.attributes.power.value" value="{{system.attributes.power.value}}" data-dtype="Number"></label>
        </div>
      </section>

      <section class="filigree-box race-manager">
        <h3><i class="fas fa-dna"></i><span>{{localize "DBZ.Race"}}</span></h3>

        {{#if primaryRaceItem}}
        <div class="race-pill">
          <div>
            <strong>{{primaryRaceItem.name}}</strong>
            <span>{{primaryRaceItem.system.category}}</span>
          </div>
          <button type="button" class="icon-button" data-action="delete-race-item" data-item-id="{{primaryRaceItem.id}}" title="{{localize 'DBZ.RemoveRace'}}">
            <i class="fas fa-trash"></i>
          </button>
        </div>
        {{else}}
        <div class="empty-race">{{localize "DBZ.NoRace"}}</div>
        {{/if}}

        <div class="race-picker">
          <select name="dbz.race">
            <option value="">— {{localize "DBZ.SelectRace"}} —</option>
            {{#each races}}
            <option value="{{id}}">{{name}}</option>
            {{/each}}
          </select>
          <button type="button" class="gold-button" data-action="create-race">{{localize "DBZ.AddRace"}}</button>
        </div>

        <div class="race-picker">
          <select name="dbz.subrace">
            <option value="">— {{localize "DBZ.SelectSubrace"}} —</option>
            {{#each subraces}}
            <option value="{{id}}">{{name}}</option>
            {{/each}}
          </select>
          <button type="button" class="gold-button" data-action="create-subrace">{{localize "DBZ.AddSubrace"}}</button>
        </div>
      </section>
    </aside>

    <main class="main">

      <section class="ability-scores filigree-box">
        <h3><i class="fas fa-dice-d20"></i><span>{{localize "DBZ.Abilities"}}</span></h3>
        <div class="ability-grid">
          {{#each abilities as |ability|}}
          <div class="ability-score" data-ability="{{ability.key}}">
            <a class="label" data-action="rollAbility" data-ability="{{ability.key}}">{{localize ability.abbr}}</a>
            <div class="score">
              <input type="number" name="system.abilities.{{ability.key}}.value" value="{{ability.value}}" data-dtype="Number">
            </div>
            <div class="mod">{{numberFormat ability.mod sign=true}}</div>
            <div class="save">
              <input type="checkbox" name="system.abilities.{{ability.key}}.proficient" {{checked ability.proficient}}>
              <span>{{localize "DBZ.Save"}}</span>
              <strong>{{numberFormat ability.save sign=true}}</strong>
            </div>
            <div class="max"><span>{{localize "DBZ.Max"}}</span><input type="number" name="system.abilities.{{ability.key}}.max" value="{{ability.max}}" data-dtype="Number"></div>
          </div>
          {{/each}}
        </div>
      </section>

      <section class="content-grid">
        <div class="filigree-box skills">
          <h3><i class="fas fa-briefcase"></i><span>{{localize "DBZ.Skills"}}</span></h3>
          <ul>
            {{#each skills as |skill|}}
            <li>
              <select name="system.skills.{{skill.key}}.value" data-dtype="Number" aria-label="{{localize skill.label}}">
                <option value="0" {{#if skill.isNone}}selected{{/if}}>—</option>
                <option value="1" {{#if skill.isProficient}}selected{{/if}}>●</option>
                <option value="2" {{#if skill.isExpert}}selected{{/if}}>●●</option>
              </select>
              <a data-action="rollSkill" data-skill="{{skill.key}}">{{localize skill.label}}</a>
              <span class="ability">{{localize skill.abilityAbbr}}</span>
              <strong>{{numberFormat skill.mod sign=true}}</strong>
            </li>
            {{/each}}
          </ul>
        </div>

        <div class="filigree-box racial-features">
          <h3><i class="fas fa-scroll"></i><span>{{localize "DBZ.RacialFeatures"}}</span></h3>
          {{#if raceFeatures}}
            {{#each raceFeatures as |race|}}
            <div class="race-feature-group">
              <div class="feature-heading">
                <strong>{{race.name}}</strong>
                {{#if race.subrace}}<span>{{localize "DBZ.Subrace"}}</span>{{/if}}
                <button type="button" class="icon-button" data-action="delete-race-item" data-item-id="{{race.itemId}}">
                  <i class="fas fa-trash"></i>
                </button>
              </div>
              {{#each race.features as |feature|}}
              <article class="race-feature">
                <h4>{{feature.name}}</h4>
                <div class="description">{{{feature.html}}}</div>
              </article>
              {{/each}}
            </div>
            {{/each}}
          {{else}}
            <p class="muted">{{localize "DBZ.NoRaceFeatures"}}</p>
          {{/if}}
        </div>
      </section>

      <section class="filigree-box notes-section">
        <h3><i class="fas fa-feather"></i><span>{{localize "DBZ.Notes"}}</span></h3>
        <textarea name="system.notes">{{system.notes}}</textarea>
      </section>
    </main>
  </div>
</form>
