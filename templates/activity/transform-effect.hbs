<section class="tab activity-{{ tab.id }} {{ tab.cssClass }}" data-tab="{{ tab.id }}" data-group="{{ tab.group }}">
    {{#if (eq activity.transform.mode "form")}}

    {{> "systems/dragons-and-ballz/templates/activity/parts/activity-effects.hbs" labels=effects.labels remote=false }}

    {{else}}

    {{> "templates/generic/tab-navigation.hbs" tabs=tabs.effect.tabs }}
    {{> "systems/dragons-and-ballz/templates/activity/parts/transform-profiles.hbs" tab=tabs.effect.tabs.profiles }}
    {{> "systems/dragons-and-ballz/templates/activity/parts/transform-settings.hbs" tab=tabs.effect.tabs.settings }}

    {{/if}}
</section>
